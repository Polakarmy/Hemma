# انسخ هذا الملف إلى .env.local للتجربة المحلية (ولا ترفع .env.local على GitHub أبدًا).
# على Vercel: Project Settings → Environment Variables.

# مطلوب: مفتاح Claude API (يُقرأ على السيرفر فقط، ليس له بادئة VITE_ عمدًا)
ANTHROPIC_API_KEY=

# اختياري: الموديل المستخدم (الافتراضي سريع ورخيص)
ASSISTANT_MODEL=claude-haiku-5-5

# اختياري: نطاقات إضافية مسموح لها باستدعاء الدالة، مفصولة بفاصلة
# ALLOWED_ORIGINS=https://hemma-tan.vercel.app
